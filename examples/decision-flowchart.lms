# Decision/branching flowchart: start stadium, process box, decision
# diamond, yes/no branches that merge again, end stadium. Elbow edges
# (H/V path commands) and hand-built arrowheads. Colors are literal
# because script fns cannot capture chunk-level lets.
out = ARGV.len() > 0 ? ARGV[0] : "build/decision-flowchart.dslb";
p = _dsl_ schema="../schema/lmdraw.dsl.json";
scene.canvas(960, 560, "#101820");

fn arrowhead(x: float, y: float, ux: float, uy: float, color: string) -> void {
  let px = -uy;
  let py = ux;
  let hx = x - ux * 12.0;
  let hy = y - uy * 12.0;
  scene.path("M " + str(x) + " " + str(y) +
    " L " + str(hx + px * 6.5) + " " + str(hy + py * 6.5) +
    " L " + str(hx - px * 6.5) + " " + str(hy - py * 6.5) + " Z", color, "none", 1.0);
}

fn stadium(x: float, y: float, w: float, h: float, title: string) -> void {
  let r = scene.rect(x - w / 2.0, y - h / 2.0, w, h, "#1e3247");
  r.set_attr("stroke", "#f5c16c");
  r.set_attr("stroke-width", "2");
  r.set_attr("rx", str(h / 2.0));
  let label = scene.text(x, y + 5.0, 16.0, title, "#dbe7f3");
  label.set_attr("text-anchor", "middle");
}

fn process(x: float, y: float, w: float, h: float, title: string) -> void {
  let r = scene.rect(x - w / 2.0, y - h / 2.0, w, h, "#1e3247");
  r.set_attr("stroke", "#4a6a88");
  r.set_attr("stroke-width", "2");
  r.set_attr("rx", "8");
  let label = scene.text(x, y + 5.0, 16.0, title, "#dbe7f3");
  label.set_attr("text-anchor", "middle");
}

# start -> process -> decision
stadium(480.0, 60.0, 140.0, 44.0, "start");
process(480.0, 170.0, 180.0, 64.0, "collect samples");
scene.line(480.0, 82.0, 480.0, 126.0, "#f5c16c", 2.5);
arrowhead(480.0, 126.0, 0.0, 1.0, "#f5c16c");

# decision diamond built from a path
scene.path("M 480.0 250.0 L 570.0 310.0 L 480.0 370.0 L 390.0 310.0 Z",
  "#1e3247", "#4a6a88", 2.0);
let q = scene.text(480.0, 315.0, 15.0, "enough?", "#dbe7f3");
q.set_attr("text-anchor", "middle");
scene.line(480.0, 202.0, 480.0, 238.0, "#f5c16c", 2.5);
arrowhead(480.0, 238.0, 0.0, 1.0, "#f5c16c");

# yes branch: elbow right, process, back into merge
scene.path("M 570.0 310.0 H 710.0 V 430.0 H 640.0", "none", "#6fbdb4", 2.5);
arrowhead(640.0, 430.0, -1.0, 0.0, "#6fbdb4");
let yes_tag = scene.text(648.0, 298.0, 14.0, "yes", "#6fbdb4");
yes_tag.set_attr("text-anchor", "middle");
process(640.0, 430.0, 150.0, 60.0, "ship it");

# no branch: elbow left, process, back into merge
scene.path("M 390.0 310.0 H 250.0 V 430.0 H 320.0", "none", "#d9897a", 2.5);
arrowhead(320.0, 430.0, 1.0, 0.0, "#d9897a");
let no_tag = scene.text(312.0, 298.0, 14.0, "no", "#d9897a");
no_tag.set_attr("text-anchor", "middle");
process(320.0, 430.0, 150.0, 60.0, "collect more");

# merge into end stadium
scene.line(480.0, 370.0, 480.0, 478.0, "#f5c16c", 2.5);
arrowhead(480.0, 478.0, 0.0, 1.0, "#f5c16c");
stadium(480.0, 500.0, 140.0, 44.0, "done");
scene.render_png("build/rendered/decision-flowchart.png", 960, 560, 1);
end _dsl_
savedsl(p, out);
println(f"wrote {out}");

# OAuth refresh-token sequence diagram: three participants, dashed
# lifelines, solid request arrows and dashed response arrows with
# numbered labels, a self-message loop on the gateway, and activation
# bars on the gateway and auth-server lifelines. Sequence notation comes
# from the host diagram API; positions stay explicit.
out = ARGV.len() > 0 ? ARGV[0] : "build/sequence-oauth-refresh.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1000, 620, "#101820");

scene.text(40.0, 44.0, 22.0, "OAuth refresh token flow", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "an expired access token, refreshed mid-request", "#9db4c8");

let client = scene.box(180.0, 106.0, 160.0, 44.0, "client", "#1e3247", "#4a6a88", 8.0, 15.0);
let gateway = scene.box(500.0, 106.0, 160.0, 44.0, "API gateway", "#1e3247", "#4a6a88", 8.0, 15.0);
let auth = scene.box(820.0, 106.0, 160.0, 44.0, "auth server", "#1e3247", "#4a6a88", 8.0, 15.0);

scene.lifeline(180.0, 128.0, 580.0, "#4a6a88");
scene.lifeline(500.0, 128.0, 580.0, "#4a6a88");
scene.lifeline(820.0, 128.0, 580.0, "#4a6a88");

# activation bars (drawn before messages so arrows stay on top)
scene.activation(500.0, 140.0, 500.0, "#3d5a76", "#8fb4d9");
scene.activation(820.0, 195.0, 440.0, "#3d5a76", "#8fb4d9");

scene.message(188.0, 160.0, 492.0, 160.0, "1  GET /orders (access token)", false, "#f5c16c");
scene.message(508.0, 215.0, 812.0, 215.0, "2  introspect token", false, "#f5c16c");
scene.message(812.0, 270.0, 508.0, 270.0, "3  401 token expired", true, "#f5c16c");
scene.self_message(504.0, 315.0, "4  rotate refresh token", "#f5c16c");
scene.message(508.0, 375.0, 812.0, 375.0, "5  POST /oauth/refresh", false, "#f5c16c");
scene.message(812.0, 430.0, 508.0, 430.0, "6  200 OK + new tokens", true, "#f5c16c");
scene.message(492.0, 485.0, 188.0, 485.0, "7  200 OK (retry)", true, "#f5c16c");

# legend
let lg1 = scene.line(700.0, 48.0, 742.0, 48.0, "#f5c16c", 2.0);
lg1.set_attr("marker-end", "arrow");
scene.text(750.0, 52.0, 12.0, "request", "#9db4c8");
let lg2 = scene.line(700.0, 70.0, 742.0, 70.0, "#f5c16c", 2.0);
lg2.set_attr("marker-end", "arrow");
lg2.set_attr("stroke-dasharray", "6 5");
scene.text(750.0, 74.0, 12.0, "response", "#9db4c8");

scene.render_png("build/rendered/sequence-oauth-refresh.png", 1000, 620, 1);
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/sequence-oauth-refresh.png", "images/sequence-oauth-refresh.png");
println("wrote images/sequence-oauth-refresh.png");

# Four small state machines on one canvas (2x2 panels): traffic light,
# TCP connection, door lock and thermostat. States are rounded boxes from
# the host diagram API, each panel has a filled initial-state dot with an
# arrow, and transitions are labeled arrows (straight, curved, or custom
# arcs). Positions stay explicit.
out = ARGV.len() > 0 ? ARGV[0] : "build/state-machines.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1100, 800, "#101820");

scene.text(40.0, 44.0, 22.0, "State machines", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "four small protocols, one notation", "#9db4c8");

fn panel(x: float, y: float, title: string) -> void {
  scene.cluster(x, y, 510.0, 350.0, "", "#131c28", "#2c4156", 12.0, 13.0);
  scene.text(x + 22.0, y + 36.0, 16.0, title, "#dbe7f3").set_attr("font-weight", "700");
}

fn initial_dot(x: float, y: float, state: Shape) -> void {
  scene.circle(x, y, 6.0, "#f5c16c");
  scene.connector(x + 8.0, y, state, "w", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "", 0.5, 0.0, 0.0);
}

# --- panel 1: traffic light (top-left)
panel(40.0, 90.0, "traffic light");
let red = scene.box(170.0, 220.0, 110.0, 48.0, "red", "#1e3247", "#4a6a88", 10.0, 14.0);
let green = scene.box(420.0, 220.0, 110.0, 48.0, "green", "#1e3247", "#4a6a88", 10.0, 14.0);
let yellow = scene.box(295.0, 360.0, 120.0, 48.0, "yellow", "#1e3247", "#4a6a88", 10.0, 14.0);
initial_dot(80.0, 220.0, red);
scene.connector(red, "e", green, "w", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "after 30 s", 0.5, 0.0, -15.0);
scene.connector(410.0, 244.0, 345.0, 338.0, "straight", "none", "arrow", "none", "#f5c16c", 2.0, "after 25 s", 0.5, 37.5, 9.0);
scene.connector(245.0, 338.0, 180.0, 244.0, "straight", "none", "arrow", "none", "#f5c16c", 2.0, "after 5 s", 0.5, -37.5, 9.0);

# --- panel 2: TCP connection (top-right)
panel(590.0, 90.0, "TCP connection");
let closed_st = scene.box(720.0, 350.0, 130.0, 48.0, "CLOSED", "#1e3247", "#4a6a88", 10.0, 14.0);
let syn_sent = scene.box(720.0, 170.0, 130.0, 48.0, "SYN_SENT", "#1e3247", "#4a6a88", 10.0, 14.0);
let established = scene.box(945.0, 170.0, 130.0, 48.0, "ESTABLISHED", "#1e3247", "#4a6a88", 10.0, 14.0);
let fin_wait = scene.box(945.0, 350.0, 130.0, 48.0, "FIN_WAIT", "#1e3247", "#4a6a88", 10.0, 14.0);
initial_dot(625.0, 350.0, closed_st);
scene.connector(closed_st, "n", syn_sent, "s", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "SYN", 0.5, -22.0, 2.0);
scene.connector(syn_sent, "e", established, "w", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "SYN + ACK", 0.5, 0.0, -15.0);
scene.connector(established, "s", fin_wait, "n", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "FIN", 0.5, 23.0, 0.0);
scene.connector(fin_wait, "w", closed_st, "e", "straight", "none", "arrow", "none", "#f5c16c", 2.0, "ACK", 0.5, 0.0, 22.0);

# --- panel 3: door lock (bottom-left); the two arcs are custom curves
# (same-height endpoints), so they stay as explicit path data
panel(40.0, 440.0, "door lock");
let locked = scene.box(165.0, 600.0, 150.0, 52.0, "LOCKED", "#1e3247", "#4a6a88", 10.0, 14.0);
let unlocked = scene.box(425.0, 600.0, 160.0, 52.0, "UNLOCKED", "#1e3247", "#4a6a88", 10.0, 14.0);
initial_dot(58.0, 600.0, locked);
scene.path("M 240.0 582.0 C 290.0 530.0 350.0 530.0 350.0 582.0", "none", "#f5c16c", 2.0).set_attr("marker-end", "arrow");
scene.text(295.0, 545.0, 12.0, "unlock (code ok)", "#9db4c8").set_attr("text-anchor", "middle");
scene.path("M 350.0 618.0 C 350.0 670.0 290.0 670.0 240.0 618.0", "none", "#f5c16c", 2.0).set_attr("marker-end", "arrow");
scene.text(295.0, 690.0, 12.0, "lock / 30 s timeout", "#9db4c8").set_attr("text-anchor", "middle");

# --- panel 4: thermostat (bottom-right)
panel(590.0, 440.0, "thermostat");
let idle = scene.box(700.0, 600.0, 130.0, 50.0, "IDLE", "#1e3247", "#4a6a88", 10.0, 14.0);
let heating = scene.box(945.0, 510.0, 130.0, 50.0, "HEATING", "#1e3247", "#4a6a88", 10.0, 14.0);
let cooling = scene.box(945.0, 690.0, 130.0, 50.0, "COOLING", "#1e3247", "#4a6a88", 10.0, 14.0);
initial_dot(605.0, 600.0, idle);
scene.connector(idle, "ne", heating, "sw", "curve", "none", "arrow", "none", "#f5c16c", 2.0, "T < set - 1", 0.5, 20.0, -10.0);
scene.connector(heating, "sw", idle, "ne", "curve", "none", "arrow", "none", "#f5c16c", 2.0, "T >= set", 0.5, 24.0, 18.0);
scene.connector(idle, "se", cooling, "nw", "curve", "none", "arrow", "none", "#f5c16c", 2.0, "T > set + 1", 0.5, -25.0, 45.0);
scene.connector(cooling, "nw", idle, "se", "curve", "none", "arrow", "none", "#f5c16c", 2.0, "T <= set", 0.5, -45.0, -25.0);

scene.render_png("build/rendered/state-machines.png", 1100, 800, 1);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/state-machines.png", "images/state-machines.png");
println("wrote images/state-machines.png");

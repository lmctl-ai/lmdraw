# ER sketch of an order system: five entities (rectangle with a title
# band and attribute lines), four relationship diamonds with
# cardinality labels at both ends, and a self-relationship loop on
# CUSTOMER (referrer). Colors are literals because script fns cannot
# capture chunk-level lets.
out = ARGV.len() > 0 ? ARGV[0] : "build/entity-relationship.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1000, 640, "#101820");

scene.text(40.0, 44.0, 22.0, "Order system ER sketch", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "entities, relationship diamonds, 1:N cardinalities", "#9db4c8");

fn entity(x: float, y: float, w: float, title: string,
  a1: string, a2: string, a3: string, a4: string) -> void {
  let body_h = 10.0 + 4.0 * 22.0;
  let band = scene.rect(x, y, w, 28.0, "#24405c");
  band.set_attr("stroke", "#4a6a88");
  band.set_attr("stroke-width", "2");
  let body = scene.rect(x, y + 28.0, w, body_h, "#1e3247");
  body.set_attr("stroke", "#4a6a88");
  body.set_attr("stroke-width", "2");
  let t = scene.text(x + w / 2.0, y + 19.0, 14.0, title, "#dbe7f3");
  t.set_attr("text-anchor", "middle");
  t.set_attr("font-weight", "700");
  scene.text(x + 12.0, y + 50.0, 12.0, a1, "#c9d6e2");
  scene.text(x + 12.0, y + 72.0, 12.0, a2, "#c9d6e2");
  scene.text(x + 12.0, y + 94.0, 12.0, a3, "#c9d6e2");
  scene.text(x + 12.0, y + 116.0, 12.0, a4, "#c9d6e2");
}

fn rel_diamond(cx: float, cy: float, label: string) -> void {
  let d = "M " + str(cx) + " " + str(cy - 26.0) +
    " L " + str(cx + 55.0) + " " + str(cy) +
    " L " + str(cx) + " " + str(cy + 26.0) +
    " L " + str(cx - 55.0) + " " + str(cy) + " Z";
  scene.path(d, "#1e3247", "#6fbdb4", 2.0);
  let t = scene.text(cx, cy + 4.0, 12.0, label, "#dbe7f3");
  t.set_attr("text-anchor", "middle");
}

fn rel_line(x1: float, y1: float, x2: float, y2: float) -> void {
  scene.line(x1, y1, x2, y2, "#8fb4d9", 1.8);
}

fn card(x: float, y: float, s: string) -> void {
  let t = scene.text(x, y, 12.0, s, "#f5c16c");
  t.set_attr("text-anchor", "middle");
  t.set_attr("font-weight", "700");
}

# entities
entity(60.0, 130.0, 190.0, "CUSTOMER", "id : int", "name : text", "email : text", "referrer_id : int");
entity(400.0, 120.0, 180.0, "ORDER", "id : int", "customer_id : int", "status : text", "total : money");
entity(700.0, 130.0, 180.0, "PRODUCT", "id : int", "sku : text", "price : money", "stock : int");
entity(230.0, 420.0, 190.0, "PAYMENT", "id : int", "order_id : int", "method : text", "amount : money");
entity(620.0, 420.0, 190.0, "SHIPMENT", "id : int", "order_id : int", "carrier : text", "eta : date");

# CUSTOMER - places - ORDER
rel_diamond(325.0, 188.0, "places");
rel_line(250.0, 193.0, 270.0, 188.0);
rel_line(380.0, 188.0, 400.0, 183.0);
card(259.0, 176.0, "1");
card(372.0, 176.0, "N");

# ORDER - contains - PRODUCT
rel_diamond(640.0, 178.0, "contains");
rel_line(580.0, 173.0, 585.0, 178.0);
rel_line(695.0, 178.0, 700.0, 193.0);
card(576.0, 162.0, "N");
card(694.0, 176.0, "M");

# ORDER - pays - PAYMENT
rel_diamond(407.0, 343.0, "pays");
rel_line(470.0, 248.0, 415.0, 319.0);
rel_line(400.0, 367.0, 340.0, 446.0);
card(448.0, 284.0, "1");
card(352.0, 414.0, "1");

# ORDER - ships - SHIPMENT
rel_diamond(617.0, 343.0, "ships");
rel_line(512.0, 248.0, 605.0, 319.0);
rel_line(630.0, 367.0, 690.0, 446.0);
card(544.0, 284.0, "1");
card(678.0, 414.0, "N");

# CUSTOMER self-relationship: referrer (1:N)
let loop = scene.path("M 100.0 130.0 C 96.0 92.0 214.0 92.0 210.0 130.0", "none", "#8fb4d9", 1.8);
loop.set_attr("marker-end", "arrow");
let lt = scene.text(155.0, 88.0, 12.0, "refers (1:N)", "#9db4c8");
lt.set_attr("text-anchor", "middle");

scene.render_png("build/rendered/entity-relationship.png", 1000, 640, 1);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/entity-relationship.png", "images/entity-relationship.png");
println("wrote images/entity-relationship.png");

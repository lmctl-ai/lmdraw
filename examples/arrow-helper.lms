# A compact coordinate frame using the retained arrow helper.
out = ARGV.len() > 0 ? ARGV[0] : "build/arrow-helper.dslb";
p = _dsl_ schema="../schema/lmdraw.dsl.json";
scene.canvas(900, 600, "#101820");
scene.axes(110.0, 70.0, 700.0, 430.0, 0.0, 10.0, -1.0, 1.0, 5, "#4a6a88");
scene.arrow(110.0, 500.0, 820.0, 500.0, "#6fbdb4", 2.5);
scene.arrow(110.0, 500.0, 110.0, 58.0, "#f5c16c", 2.5);
scene.text(826.0, 505.0, 16.0, "x", "#6fbdb4");
scene.text(102.0, 52.0, 16.0, "y", "#f5c16c");
scene.text(142.0, 112.0, 24.0, "vector field frame", "#dbe7f3");
scene.render_png("build/rendered/arrow-helper.png", 900, 600, 1);
end _dsl_
savedsl(p, out);

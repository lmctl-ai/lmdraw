# Swimlane process diagram: four horizontal lanes (customer / frontend /
# backend / payments) with process boxes and a decision diamond placed
# per lane; connectors flow left to right, drop or climb between lanes,
# and carry small labels; the payment-failure retry edge is dashed. The
# retry loop needs three bends, so it stays as explicit path data.
out = ARGV.len() > 0 ? ARGV[0] : "build/swimlane-process.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1300, 660, "#101820");

scene.text(40.0, 44.0, 22.0, "Checkout swimlane", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "who does what, flowing left to right", "#9db4c8");

fn lane(y1: float, y2: float, label: string) -> void {
  scene.cluster(40.0, y1, 1240.0, y2 - y1, "", "#131c28", "#2c4156", 0.0, 13.0);
  scene.text(56.0, (y1 + y2) / 2.0 + 5.0, 14.0, label, "#6fbdb4").set_attr("font-weight", "700");
}

lane(90.0, 220.0, "customer");
lane(220.0, 350.0, "frontend");
lane(350.0, 480.0, "backend");
lane(480.0, 610.0, "payments");

# nodes
let submit = scene.box(240.0, 155.0, 150.0, 56.0, "submit order", "#1e3247", "#4a6a88", 8.0, 14.0);
let validate = scene.box(420.0, 285.0, 150.0, 56.0, "validate cart", "#1e3247", "#4a6a88", 8.0, 14.0);
let show_soldout = scene.box(700.0, 285.0, 150.0, 56.0, "show sold out", "#1e3247", "#4a6a88", 8.0, 14.0);
let notice = scene.box(700.0, 155.0, 150.0, 56.0, "sold-out notice", "#1e3247", "#4a6a88", 8.0, 14.0);
let stock = scene.diamond(600.0, 415.0, 150.0, 84.0, "in stock?", "#1e3247", "#f5c16c", 13.0);
let reserve = scene.box(860.0, 415.0, 150.0, 56.0, "reserve items", "#1e3247", "#4a6a88", 8.0, 14.0);
let charge = scene.box(860.0, 545.0, 150.0, 56.0, "charge card", "#1e3247", "#4a6a88", 8.0, 14.0);
let charge_ok = scene.diamond(1020.0, 545.0, 140.0, 84.0, "charge ok?", "#1e3247", "#f5c16c", 13.0);
let create = scene.box(1020.0, 415.0, 150.0, 56.0, "create order", "#1e3247", "#4a6a88", 8.0, 14.0);
let confirm = scene.box(1020.0, 285.0, 150.0, 56.0, "show confirmation", "#1e3247", "#4a6a88", 8.0, 14.0);
let receipt = scene.box(1020.0, 155.0, 150.0, 56.0, "gets receipt", "#1e3247", "#4a6a88", 8.0, 14.0);
let failed = scene.box(1215.0, 155.0, 150.0, 56.0, "payment failed", "#1e3247", "#4a6a88", 8.0, 14.0);

# flow
scene.connector(submit, "e", validate, "n", "elbow", "none", "arrow", "none", "#8fb4d9", 2.0, "order", 0.2, 0.0, -12.0);
scene.connector(validate, "e", stock, "n", "elbow", "none", "arrow", "none", "#8fb4d9", 2.0, "cart", 0.5, 0.0, -9.0);
scene.connector(stock, "e", show_soldout, "w", "curve", "none", "arrow", "none", "#8fb4d9", 2.0, "no", 0.5, 20.0, 0.0);
scene.connector(show_soldout, "n", notice, "s", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "notice", 0.5, 28.0, 0.0);
scene.connector(stock, "e", reserve, "w", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "yes", 0.5, 0.0, -13.0);
scene.connector(reserve, "s", charge, "n", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "charge", 0.5, 28.0, 0.0);
scene.connector(charge, "e", charge_ok, "w", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(charge_ok, "n", create, "s", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "yes", 0.5, 26.0, 0.0);
scene.connector(create, "n", confirm, "s", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(confirm, "n", receipt, "s", "straight", "none", "arrow", "none", "#8fb4d9", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(charge_ok, "e", failed, "s", "elbow", "none", "arrow", "none", "#8fb4d9", 2.0, "no", 0.1, 62.0, 36.0);
scene.path("M 1215.0 127.0 V 100.0 H 500.0 V 545.0 H 782.0", "none", "#8fb4d9", 2.0).set_attr("marker-end", "arrow").set_attr("stroke-dasharray", "6 5");
scene.text(857.0, 92.0, 12.0, "retry", "#9db4c8").set_attr("text-anchor", "middle");

scene.render_png("build/rendered/swimlane-process.png", 1300, 660, 1);
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/swimlane-process.png", "images/swimlane-process.png");
println("wrote images/swimlane-process.png");

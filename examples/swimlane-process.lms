# Swimlane process diagram: four horizontal lanes (customer / frontend /
# backend / payments) with process boxes and a decision diamond placed
# per lane; connectors flow left to right, drop or climb between lanes,
# and carry small labels; the payment-failure retry edge is dashed.
# Colors are literals because script fns cannot capture chunk-level lets.
out = ARGV.len() > 0 ? ARGV[0] : "build/swimlane-process.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1300, 660, "#101820");

scene.text(40.0, 44.0, 22.0, "Checkout swimlane", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "who does what, flowing left to right", "#9db4c8");

fn lane(y1: float, y2: float, label: string) -> void {
  let r = scene.rect(40.0, y1, 1240.0, y2 - y1, "#131c28");
  r.set_attr("stroke", "#2c4156");
  r.set_attr("stroke-width", "1.5");
  let t = scene.text(56.0, (y1 + y2) / 2.0 + 5.0, 14.0, label, "#6fbdb4");
  t.set_attr("font-weight", "700");
}

fn step_box(x: float, y: float, w: float, title: string) -> void {
  let r = scene.rect(x - w / 2.0, y - 28.0, w, 56.0, "#1e3247");
  r.set_attr("stroke", "#4a6a88");
  r.set_attr("stroke-width", "2");
  r.set_attr("rx", "8");
  let t = scene.text(x, y + 5.0, 14.0, title, "#dbe7f3", w - 14.0);
  t.set_attr("text-anchor", "middle");
}

fn diamond(cx: float, cy: float, w: float, h: float, label: string) -> void {
  let d = "M " + str(cx) + " " + str(cy - h / 2.0) +
    " L " + str(cx + w / 2.0) + " " + str(cy) +
    " L " + str(cx) + " " + str(cy + h / 2.0) +
    " L " + str(cx - w / 2.0) + " " + str(cy) + " Z";
  scene.path(d, "#1e3247", "#f5c16c", 2.0);
  let t = scene.text(cx, cy + 4.0, 13.0, label, "#dbe7f3", w - 20.0);
  t.set_attr("text-anchor", "middle");
}

fn flow(d: string, label: string, lx: float, ly: float, dashed: bool) -> void {
  let e = scene.path(d, "none", "#8fb4d9", 2.0);
  e.set_attr("marker-end", "arrow");
  if (dashed) { e.set_attr("stroke-dasharray", "6 5"); }
  if (label != "") {
    let t = scene.text(lx, ly, 12.0, label, "#9db4c8");
    t.set_attr("text-anchor", "middle");
  }
}

lane(90.0, 220.0, "customer");
lane(220.0, 350.0, "frontend");
lane(350.0, 480.0, "backend");
lane(480.0, 610.0, "payments");

# nodes
step_box(240.0, 155.0, 150.0, "submit order");
step_box(420.0, 285.0, 150.0, "validate cart");
step_box(700.0, 285.0, 150.0, "show sold out");
step_box(700.0, 155.0, 150.0, "sold-out notice");
diamond(600.0, 415.0, 150.0, 84.0, "in stock?");
step_box(860.0, 415.0, 150.0, "reserve items");
step_box(860.0, 545.0, 150.0, "charge card");
diamond(1020.0, 545.0, 140.0, 84.0, "charge ok?");
step_box(1020.0, 415.0, 150.0, "create order");
step_box(1020.0, 285.0, 150.0, "show confirmation");
step_box(1020.0, 155.0, 150.0, "gets receipt");
step_box(1215.0, 155.0, 150.0, "payment failed");

# flow
flow("M 315.0 155.0 H 380.0 V 253.0", "order", 352.0, 143.0, false);
flow("M 495.0 285.0 H 600.0 V 369.0", "cart", 548.0, 320.0, false);
flow("M 637.0 394.0 C 660.0 360.0 680.0 340.0 700.0 320.0", "no", 672.0, 352.0, false);
flow("M 700.0 257.0 V 191.0", "notice", 728.0, 224.0, false);
flow("M 675.0 415.0 H 782.0", "yes", 728.0, 402.0, false);
flow("M 860.0 443.0 V 513.0", "charge", 888.0, 482.0, false);
flow("M 935.0 545.0 H 948.0", "", 0.0, 0.0, false);
flow("M 1020.0 503.0 V 447.0", "yes", 1046.0, 478.0, false);
flow("M 1020.0 387.0 V 317.0", "", 0.0, 0.0, false);
flow("M 1020.0 257.0 V 191.0", "", 0.0, 0.0, false);
flow("M 1090.0 545.0 H 1215.0 V 189.0", "no", 1152.0, 532.0, false);
flow("M 1215.0 127.0 V 100.0 H 500.0 V 545.0 H 782.0", "retry", 857.0, 92.0, true);

scene.render_png("build/rendered/swimlane-process.png", 1300, 660, 1);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/swimlane-process.png", "images/swimlane-process.png");
println("wrote images/swimlane-process.png");

# Order approval flowchart: start stadium, validation, two decision
# diamonds in series (in stock? payment ok?), approve/reject branches,
# elbow connectors with named markers and yes/no labels. Colors are
# literals because script fns cannot capture chunk-level lets.
out = ARGV.len() > 0 ? ARGV[0] : "build/flowchart-order-approval.dslb";
mkdir("images");
mkdir("build");
mkdir("build/rendered");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(960, 600, "#101820");

scene.text(40.0, 44.0, 22.0, "Order approval", "#dbe7f3").set_attr("font-weight", "700");
scene.text(40.0, 68.0, 14.0, "two decision gates: inventory, then payment", "#9db4c8");

fn stadium(x: float, y: float, w: float, h: float, title: string) -> void {
  let r = scene.rect(x - w / 2.0, y - h / 2.0, w, h, "#1e3247");
  r.set_attr("stroke", "#f5c16c");
  r.set_attr("stroke-width", "2");
  r.set_attr("rx", str(h / 2.0));
  let label = scene.text(x, y + 5.0, 15.0, title, "#dbe7f3", w - 20.0);
  label.set_attr("text-anchor", "middle");
}

fn process(x: float, y: float, w: float, h: float, title: string) -> void {
  let r = scene.rect(x - w / 2.0, y - h / 2.0, w, h, "#1e3247");
  r.set_attr("stroke", "#4a6a88");
  r.set_attr("stroke-width", "2");
  r.set_attr("rx", "8");
  let label = scene.text(x, y + 5.0, 15.0, title, "#dbe7f3", w - 20.0);
  label.set_attr("text-anchor", "middle");
}

fn diamond(cx: float, cy: float, w: float, h: float, label: string) -> void {
  let d = "M " + str(cx) + " " + str(cy - h / 2.0) +
    " L " + str(cx + w / 2.0) + " " + str(cy) +
    " L " + str(cx) + " " + str(cy + h / 2.0) +
    " L " + str(cx - w / 2.0) + " " + str(cy) + " Z";
  scene.path(d, "#1e3247", "#4a6a88", 2.0);
  let t = scene.text(cx, cy + 5.0, 14.0, label, "#dbe7f3", w - 30.0);
  t.set_attr("text-anchor", "middle");
}

fn edge(d: string, color: string) -> void {
  let e = scene.path(d, "none", color, 2.5);
  e.set_attr("marker-end", "arrow");
}

fn tag(x: float, y: float, s: string, color: string) -> void {
  let t = scene.text(x, y, 13.0, s, color);
  t.set_attr("text-anchor", "middle");
}

# main spine
stadium(480.0, 120.0, 170.0, 44.0, "order received");
edge("M 480.0 142.0 V 168.0", "#f5c16c");
process(480.0, 196.0, 210.0, 56.0, "validate order details");
edge("M 480.0 224.0 V 243.0", "#f5c16c");
diamond(480.0, 290.0, 200.0, 94.0, "in stock?");

# yes: approve, then payment gate
edge("M 580.0 290.0 H 730.0 V 263.0", "#6fbdb4");
tag(655.0, 278.0, "yes", "#6fbdb4");
process(730.0, 235.0, 170.0, 56.0, "approve order");
edge("M 730.0 263.0 V 331.0", "#f5c16c");
diamond(730.0, 378.0, 200.0, 94.0, "payment ok?");

# no: backorder, park on hold
edge("M 380.0 290.0 H 220.0 V 263.0", "#d9897a");
tag(300.0, 278.0, "no", "#d9897a");
process(220.0, 235.0, 170.0, 56.0, "backorder items");
edge("M 220.0 263.0 V 309.0", "#d9897a");
stadium(220.0, 332.0, 150.0, 42.0, "on hold");

# payment ok: fulfill and ship
edge("M 630.0 378.0 H 480.0 V 411.0", "#6fbdb4");
tag(555.0, 366.0, "yes", "#6fbdb4");
process(480.0, 441.0, 170.0, 56.0, "fulfill order");
edge("M 480.0 469.0 V 497.0", "#6fbdb4");
stadium(480.0, 522.0, 140.0, 42.0, "shipped");

# payment fails: reject and close
edge("M 830.0 378.0 H 885.0 V 411.0", "#d9897a");
tag(858.0, 366.0, "no", "#d9897a");
process(885.0, 441.0, 130.0, 56.0, "reject order");
edge("M 885.0 469.0 V 497.0", "#d9897a");
stadium(885.0, 522.0, 150.0, 42.0, "order closed");

scene.render_png("build/rendered/flowchart-order-approval.png", 960, 600, 1);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/flowchart-order-approval.png", "images/flowchart-order-approval.png");
println("wrote images/flowchart-order-approval.png");
